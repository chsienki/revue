<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>revue</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\static\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="..\static\icon.svg" LogicalName="icon.svg" />
  </ItemGroup>
  <Target Name="SetVersionFromFile" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\VERSION">
      <Output TaskParameter="Lines" PropertyName="VersionFromFile" />
    </ReadLinesFromFile>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShort" />
    </Exec>
    <PropertyGroup>
      <VersionFromFile Condition="'$(VersionFromFile)' == ''">0.0.0</VersionFromFile>
      <GitCommitShort Condition="'$(GitCommitShort)' == ''">unknown</GitCommitShort>
      <Version>$(VersionFromFile)</Version>
      <InformationalVersion>$(VersionFromFile)+$(GitCommitShort)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
